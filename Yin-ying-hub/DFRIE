-- 4. Optimized UI Client (รองรับทั้ง Delta Executor และ Roblox Studio)
--------------------------------------------------------------------------------
task.spawn(function()
    local playerGui = player:WaitForChild("PlayerGui")
    local GUI_NAME = "YinYangUI_System"

    local old = playerGui:FindFirstChild(GUI_NAME)
    if old then old:Destroy() end

    local C = {
        bg = Color3.fromRGB(13, 16, 20),
        panel = Color3.fromRGB(20, 26, 32),
        panel2 = Color3.fromRGB(26, 34, 42),
        hover = Color3.fromRGB(35, 48, 54),
        emerald = Color3.fromRGB(38, 220, 151),
        dark = Color3.fromRGB(18, 110, 80),
        mint = Color3.fromRGB(160, 255, 216),
        text = Color3.fromRGB(242, 247, 245),
        muted = Color3.fromRGB(135, 150, 145),
        border = Color3.fromRGB(40, 60, 55),
        gold = Color3.fromRGB(255, 215, 0)
    }

    local function make(class, props, parent)
        local o = Instance.new(class)
        for k, v in pairs(props or {}) do o[k] = v end
        o.Parent = parent
        return o
    end

    local function round(p, r) make("UICorner", {CornerRadius = UDim.new(0, r or 8)}, p) end
    local function outline(p, col, tr, th) make("UIStroke", {Color = col or C.border, Transparency = tr or 0, Thickness = th or 1}, p) end
    local function label(parent, txt, size, color, font, align)
        return make("TextLabel", {
            BackgroundTransparency = 1,
            Text = txt or "",
            Font = font or Enum.Font.Gotham,
            TextSize = size or 13,
            TextColor3 = color or C.text,
            TextXAlignment = align or Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            Size = UDim2.new(1, 0, 0, 20)
        }, parent)
    end

    -- เลือก Parent ให้รองรับ Executor (เช่น Delta ใช้ CoreGui หรือ PlayerGui)
    local parentScreen = (gethui and gethui()) or playerGui
    local screen = make("ScreenGui", {Name = GUI_NAME, ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 999}, parentScreen)

    -- Event Top HUD Banner
    local eventBanner = make("Frame", {
        Name = "EventBanner",
        BackgroundColor3 = C.panel,
        Size = UDim2.new(0, 320, 0, 46),
        Position = UDim2.new(0.5, -160, 0, -60),
        ZIndex = 50
    }, screen)
    round(eventBanner, 10); outline(eventBanner, C.emerald, 0, 1.2)
    local bannerTitle = label(eventBanner, "ECO-FRIENDLY & YIN YANG ACTIVE", 11, C.mint, Enum.Font.GothamBold)
    bannerTitle.Position = UDim2.fromOffset(12, 4)
    local bannerDesc = label(eventBanner, "ระบบเชื่อมต่อและพร้อมใช้งานแล้ว!", 9, C.text, Enum.Font.Gotham)
    bannerDesc.Position = UDim2.fromOffset(12, 22)

    -- Floating Draggable Launcher Button (ปุ่มหยินหยางลอยได้ สำหรับเปิด/ปิดเมนู)
    local launcher = make("TextButton", {
        Name = "YinYangLauncher",
        Text = "☯",
        Font = Enum.Font.GothamBlack,
        TextSize = 30,
        TextColor3 = C.mint,
        BackgroundColor3 = C.panel,
        AutoButtonColor = false,
        Size = UDim2.fromOffset(50, 50),
        Position = UDim2.new(0, 16, 0.45, 0),
        ZIndex = 100
    }, screen)
    round(launcher, 25); outline(launcher, C.emerald, 0.1, 1.5)

    -- ระบบลากปุ่ม Launcher (รองรับทั้ง Mouse และ Touch บนมือถือ Delta)
    do
        local dragging, dragStart, startPos
        launcher.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; dragStart = input.Position; startPos = launcher.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - dragStart
                launcher.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function() dragging = false end)
    end

    -- Compact Main Window
    local main = make("Frame", {
        Name = "MainWindow",
        BackgroundColor3 = C.bg,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(640, 420),
        Position = UDim2.new(0.5, -320, 0.5, -210),
        ClipsDescendants = true,
        ZIndex = 90
    }, screen)
    round(main, 14); outline(main, C.border, 0.15, 1.2)
    make("UISizeConstraint", {MinSize = Vector2.new(520, 360), MaxSize = Vector2.new(800, 520)}, main)

    local windowVisible = true
    launcher.MouseButton1Click:Connect(function()
        windowVisible = not windowVisible
        main.Visible = windowVisible
    end)

    -- Keybind 'M' หรือปุ่มลัดเพื่อเปิด/ปิด UI
    UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == Enum.KeyCode.M then
            windowVisible = not windowVisible
            main.Visible = windowVisible
        end
    end)

    print("[YinYang System] ติดตั้ง UI และระบบจัดการสำเร็จ พร้อมใช้งาน!")
end)
