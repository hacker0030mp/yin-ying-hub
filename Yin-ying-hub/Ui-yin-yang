-- 4. Mini Status Bar + ระบบ Toggle FPS & Ping
local function CreateMiniStatusBar()
	local StatusBar = Instance.new("TextButton")
	StatusBar.Name = "MiniStatusBar"
	StatusBar.Size = UDim2.new(0, 240, 0, 36)
	StatusBar.Position = UDim2.new(0, 15, 0, 15)
	StatusBar.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	StatusBar.BorderSizePixel = 0
	StatusBar.AutoButtonColor = false
	StatusBar.Text = ""
	StatusBar.ClipsDescendants = true
	StatusBar.Parent = ScreenGui

	local BarStroke = Instance.new("UIStroke")
	BarStroke.Color = Color3.fromRGB(255, 255, 255)
	BarStroke.Thickness = 1.5
	BarStroke.Parent = StatusBar

	local BarCorner = Instance.new("UICorner")
	BarCorner.CornerRadius = UDim.new(1, 0)
	BarCorner.Parent = StatusBar

	local StatusLabel = Instance.new("TextLabel")
	StatusLabel.Size = UDim2.new(1, 0, 1, 0)
	StatusLabel.BackgroundTransparency = 1
	StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	StatusLabel.TextSize = 11
	StatusLabel.Font = Enum.Font.GothamBold
	StatusLabel.Text = "☯️ YIN-YANG HUB"
	StatusLabel.Parent = StatusBar

	-- คำนวณ FPS & Ping อัปเดต Real-time
	local frameCount = 0
	local lastTime = os.clock()
	RunService.RenderStepped:Connect(function()
		frameCount = frameCount + 1
		local currentTime = os.clock()
		if currentTime - lastTime >= 1 then
			local fps = math.floor(frameCount / (currentTime - lastTime))
			local ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
			
			local textParts = {"☯️ YIN-YANG"}
			if ShowFPS then
				table.insert(textParts, "FPS: " .. tostring(fps))
			end
			if ShowPing then
				table.insert(textParts, "Ping: " .. tostring(ping) .. "ms")
			end
			
			if not ShowFPS and not ShowPing then
				StatusLabel.Text = "☯️ YIN-YANG HUB | Active"
			else
				StatusLabel.Text = table.concat(textParts, " | ")
			end

			frameCount = 0
			lastTime = currentTime
		end
	end)

	-- กล่องขยายเพิ่มเติม (ช่องที่ 2 สำหรับสวิตช์ Toggle)
	local ExpandFrame = Instance.new("Frame")
	ExpandFrame.Size = UDim2.new(1, 0, 0, 130)
	ExpandFrame.Position = UDim2.new(0, 0, 1, 5)
	ExpandFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	ExpandFrame.BorderSizePixel = 0
	ExpandFrame.Visible = false
	ExpandFrame.Parent = StatusBar

	local ExpandCorner = Instance.new("UICorner")
	ExpandCorner.CornerRadius = UDim.new(0, 10)
	ExpandCorner.Parent = ExpandFrame

	local ExpandStroke = Instance.new("UIStroke")
	ExpandStroke.Color = Color3.fromRGB(255, 255, 255)
	ExpandStroke.Thickness = 1
	ExpandStroke.Parent = ExpandFrame

	-- ปุ่ม Toggle FPS
	local ToggleFPSBtn = Instance.new("TextButton")
	ToggleFPSBtn.Size = UDim2.new(0.5, -10, 0, 32)
	ToggleFPSBtn.Position = UDim2.new(0, 8, 0, 8)
	ToggleFPSBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	ToggleFPSBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
	ToggleFPSBtn.TextSize = 10
	ToggleFPSBtn.Font = Enum.Font.GothamBold
	ToggleFPSBtn.Text = "FPS: ON"
	ToggleFPSBtn.Parent = ExpandFrame

	local FPSCorner = Instance.new("UICorner")
	FPSCorner.CornerRadius = UDim.new(0, 6)
	FPSCorner.Parent = ToggleFPSBtn

	-- ปุ่ม Toggle Ping
	local TogglePingBtn = Instance.new("TextButton")
	TogglePingBtn.Size = UDim2.new(0.5, -10, 0, 32)
	TogglePingBtn.Position = UDim2.new(0.5, 2, 0, 8)
	TogglePingBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	TogglePingBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
	TogglePingBtn.TextSize = 10
	TogglePingBtn.Font = Enum.Font.GothamBold
	TogglePingBtn.Text = "PING: ON"
	TogglePingBtn.Parent = ExpandFrame

	local PingCorner = Instance.new("UICorner")
	PingCorner.CornerRadius = UDim.new(0, 6)
	PingCorner.Parent = TogglePingBtn

	-- ปุ่ม คัดลอกชุมชน
	local FollowBtn = Instance.new("TextButton")
	FollowBtn.Size = UDim2.new(0.5, -10, 0, 28)
	FollowBtn.Position = UDim2.new(0, 8, 0, 48)
