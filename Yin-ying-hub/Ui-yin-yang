	InfoText.Size = UDim2.new(1, -10, 0, 35)
	InfoText.Position = UDim2.new(0, 5, 0, 82)
	InfoText.BackgroundTransparency = 1
	InfoText.TextColor3 = Color3.fromRGB(180, 180, 180)
	InfoText.TextSize = 9
	InfoText.Font = Enum.Font.Gotham
	InfoText.Text = "Player: " .. Player.Name .. " | YIN-YANG HUB EP 1"
	InfoText.TextWrapped = true
	InfoText.Parent = ExpandFrame

	-- สลับเปิด-ปิด กล่องขยายเมื่อคลิกที่แถบหลัก
	local isOpen = false
	StatusBar.MouseButton1Click:Connect(function()
		isOpen = not isOpen
		if isOpen then
			ExpandFrame.Visible = true
			StatusBar.Size = UDim2.new(0, 240, 0, 175)
		else
			ExpandFrame.Visible = false
			StatusBar.Size = UDim2.new(0, 240, 0, 36)
		end
	end)

	-- Event กดสลับเปิด-ปิด FPS
	ToggleFPSBtn.MouseButton1Click:Connect(function()
		ShowFPS = not ShowFPS
		if ShowFPS then
			ToggleFPSBtn.Text = "FPS: ON"
			ToggleFPSBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			ToggleFPSBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
		else
			ToggleFPSBtn.Text = "FPS: OFF"
			ToggleFPSBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
			ToggleFPSBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
	end)

	-- Event กดสลับเปิด-ปิด Ping
	TogglePingBtn.MouseButton1Click:Connect(function()
		ShowPing = not ShowPing
		if ShowPing then
			TogglePingBtn.Text = "PING: ON"
			TogglePingBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			TogglePingBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
		else
			TogglePingBtn.Text = "PING: OFF"
			TogglePingBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
			TogglePingBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
	end)

	FollowBtn.MouseButton1Click:Connect(function()
		if setclipboard then
			setclipboard("https://discord.gg/yin-yang-hub")
			FollowBtn.Text = "คัดลอกแล้ว!"
			task.wait(2)
			FollowBtn.Text = "คัดลอกชุมชน"
		end
	end)

	RejoinBtn.MouseButton1Click:Connect(function()
		TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, Player)
	end)
end

