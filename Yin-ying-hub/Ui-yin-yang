			return
		end

		task.wait(3)

		-- แจ้งเตือนรอบที่ 2
		CreateNotification("2/2", "ยืนยันครั้งสุดท้ายเพื่อเปิดใช้งาน Toggle FPS & Ping HUD", function(secondPassed)
			if not secondPassed then
				ScreenGui:Destroy()
				warn("[YIN-YANG HUB] ยกเลิกรัน EP 1 (2)")
				return
			end

			print("[YIN-YANG HUB] โหลด EP 1 สำเร็จ!")
			CreateMiniStatusBar()
		end)
	end)
end)
