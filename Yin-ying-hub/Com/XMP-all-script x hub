-- 📑 แท็บที่ 2: Script Loader (รวมสคริปต์ทั้งหมด ไร้อิโมจิที่ปุ่ม)
-- ===================================================
local ScriptTab = Window:Tab({
    Title = "Script Loader",
    Icon = "code",
})

local function addScript(sectionName, btnTitle, scriptUrl)
    local sec = ScriptTab:Section({ Title = sectionName })
    sec:Button({
        Title = btnTitle,
        Callback = function()
            pcall(function()
                loadstring(game:HttpGet(scriptUrl))()
            end)
        end
    })
end

