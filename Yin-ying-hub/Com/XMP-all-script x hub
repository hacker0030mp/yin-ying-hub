-- (โค้ดความเร็วต้นฉบับของคุณ)
local b = Instance.new("TextButton", LeftFrame)
b.Size = UDim2.new(1, 0, 0, 35)
b.Text = "ความเร็ว: ปิด"
b.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
b.TextColor3 = Color3.fromRGB(255, 255, 255)
b.Font = Enum.Font.SourceSansBold
b.TextSize = 15

local bCorner = Instance.new("UICorner", b)
bCorner.CornerRadius = UDim.new(0, 6)

local t = Instance.new("TextBox", LeftFrame)
t.Position = UDim2.new(0, 10, 0, 45)
t.Size = UDim2.new(1, -20, 0, 35)
t.Text = "32"
t.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
t.TextColor3 = Color3.fromRGB(255, 255, 255)
t.Font = Enum.Font.SourceSans
t.TextSize = 16

local tCorner = Instance.new("UICorner", t)
tCorner.CornerRadius = UDim.new(0, 6)

local on = false
b.MouseButton1Click:Connect(function()
    on = not on
    b.Text = on and "ความเร็ว: เปิด" or "ความเร็ว: ปิด"
    b.BackgroundColor3 = on and Color3.fromRGB(50, 180, 50) or Color3.fromRGB(180, 50, 50)
    
    local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if h then 
        h.WalkSpeed = on and (tonumber(t.Text) or 32) or 16 
    end
end)

t.FocusLost:Connect(function()
    if on then
        local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if h then 
            h.WalkSpeed = tonumber(t.Text) or 32 
        end
    end
end)


