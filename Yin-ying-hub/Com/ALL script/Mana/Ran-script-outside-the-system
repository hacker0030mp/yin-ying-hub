local tabs = {}
local activeTab = nil

local function createTab(tabName, icon, orderIndex)
    local page = make("ScrollingFrame", {
        Name = tabName .. "Page",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -12, 1, -12),
        Position = UDim2.new(0, 6, 0, 6),
        Visible = false,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 4,
        ZIndex = 102
    }, contentFrame)

    make("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6)
    }, page)

    local tabBtn = make("TextButton", {
        Text = (icon or "📁") .. " " .. tabName,
        Font = Enum.Font.GothamSemibold,
        TextSize = 11,
        TextColor3 = C.muted,
        BackgroundColor3 = C.bg,
        Size = UDim2.new(1, 0, 0, 32),
        LayoutOrder = orderIndex or 1,
        ZIndex = 103
    }, tabScroll)
    round(tabBtn, 6)

    tabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.page.Visible = false
            t.button.BackgroundColor3 = C.bg
            t.button.TextColor3 = C.muted
        end
        page.Visible = true
        tabBtn.BackgroundColor3 = C.panel
        tabBtn.TextColor3 = C.gold
        activeTab = tabName
    end)

    tabs[tabName] = {button = tabBtn, page = page}

    if not activeTab then
        page.Visible = true
        tabBtn.BackgroundColor3 = C.panel
        tabBtn.TextColor3 = C.gold
        activeTab = tabName
    end

    return page
end

local function addAction(page, text, callback)
    local btn = make("TextButton", {
        Text = text,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = C.text,
        BackgroundColor3 = C.panel,
        Size = UDim2.new(1, 0, 0, 34),
        ZIndex = 103
    }, page)
    round(btn, 6); outline(btn, C.border, 0.2, 1)

    if callback then
        btn.MouseButton1Click:Connect(callback)
    end
end

local function addSmallAction(page, text, callback)
