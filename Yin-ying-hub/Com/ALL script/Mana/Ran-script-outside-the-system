--------------------------------------------------------------------------------
-- 5. หมวดหมู่สุดท้าย: รันสคริปต์นอกระบบ (Order: 5 - อยู่ล่างสุดเสมอ)
--------------------------------------------------------------------------------
local pExt = createTab("รันสคริปต์นอกระบบ", "🌌", 5)

make("TextLabel", {
    BackgroundTransparency = 1,
    Text = "⚙️ ศูนย์รวมสคริปต์เสริมและ External Hubs ภายนอก",
    Font = Enum.Font.GothamBold,
    TextSize = 11,
    TextColor3 = C.purple,
    TextXAlignment = Enum.TextXAlignment.Left,
    Size = UDim2.new(1, 0, 0, 24),
    ZIndex = 103
}, pExt)

-- ลิงก์ที่ 1 (Galactic-Hub WindUI เดิม)
addAction(pExt, "🌌 Load Galactic-Hub WindUI", function()
    task.spawn(function()
        local success, err = pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/GalacticScripts/Galactic-Hub/refs/heads/main/WindUI"))()
        end)
        if success then
            print("[Galactic-Hub] โหลด WindUI สำเร็จ!")
        else
            warn("[Galactic-Hub Error]: ", err)
        end
    end)
end)

-- ➕ เพิ่มปุ่มสำหรับลิงก์ที่ 2 (เช่น zip.mm หรือลิงก์ใหม่ของคุณตรงนี้)
addAction(pExt, "🔗 Load Script 2 (zip.mm)", function()
    task.spawn(function()
        local success, err = pcall(function()
            -- เปลี่ยนลิงก์ด้านล่างนี้เป็นลิงก์ zip.mm ของคุณ
            loadstring(game:HttpGet("https://zip.mm/YOUR_NEW_SCRIPT_LINK"))()
        end)
        if success then
            print("[Script 2] โหลดสำเร็จ!")
        else
            warn("[Script 2 Error]: ", err)
        end
    end)
end)

addAction(pExt, "❌ ปิดการทำงานของเมนูทั้งหมด", function()
    screen:Destroy()
end)
