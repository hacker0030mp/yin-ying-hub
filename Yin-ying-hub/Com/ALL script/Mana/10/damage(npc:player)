-- ==========================================
-- 1. ระบบจัดการตัวเลข (Config & Parser)
-- ==========================================
local DamageConfig = {}
DamageConfig.Suffixes = {
	{ Threshold = 1e30, Suffix = "No" }, -- Nonillion
	{ Threshold = 1e27, Suffix = "Oc" }, -- Octillion
	{ Threshold = 1e24, Suffix = "Sp" }, -- Septillion
	{ Threshold = 1e21, Suffix = "Sx" }, -- Sextillion
	{ Threshold = 1e18, Suffix = "Qi" }, -- Quintillion
	{ Threshold = 1e15, Suffix = "Qa" }, -- Quadrillion
	{ Threshold = 1e12, Suffix = "T"  }, -- Trillion
	{ Threshold = 1e9,  Suffix = "B"  }, -- Billion
	{ Threshold = 1e6,  Suffix = "M"  }, -- Million
	{ Threshold = 1e3,  Suffix = "K"  }, -- Thousand
}

function DamageConfig.Parse(inputText)
	if type(inputText) ~= "string" then return 0 end
	local text = string.upper(inputText):gsub("%s+", "")
	if text == "" or #text > 30 then return 0 end

	for _, data in ipairs(DamageConfig.Suffixes) do
		local suffix = string.upper(data.Suffix)
		if text:find(suffix .. "$") then
			local numberPart = text:gsub(suffix .. "$", "")
			local val = tonumber(numberPart)
			if val then
				return val * data.Threshold
			end
		end
	end
	return tonumber(text) or 0
end

-- ==========================================
-- 2. ระบบตรวจสอบอาวุธที่ถืออยู่ในมือ (Tool Check)
-- ==========================================
local function getEquippedWeaponInfo(character)
	local tool = character:FindFirstChildOfClass("Tool")
	if tool then
		-- ถ้าถืออุปกรณ์อยู่ (เช่น ดาบ)
		-- คุณสามารถเช็คชื่ออาวุธเพื่อปรับตัวคูณดาเมจได้ เช่น ถ้าถือดาบเทพ คูณดาเมจเพิ่ม 2 เท่า
		local weaponName = tool.Name
		local multiplier = 1.0
		
		-- ตัวอย่าง: ถ้าถือไอเทมชื่อ "GodSword" ให้ดาเมจคูณ 5 เท่า
		if weaponName:lower():find("god") or weaponName:lower():find("sword") then
			multiplier = 5.0 
		end
		
		return true, weaponName, multiplier
	else
		-- ถ้ามือเปล่า (ไม่ได้ถืออะไรเลย)
		-- ดาเมจมือเปล่าอาจจะถูกกำหนดให้ลดลงเหลือ 10% หรือใช้ค่าปกติ
		return false, "มือเปล่า (Unarmed)", 0.1 
	end
end

