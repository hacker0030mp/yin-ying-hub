-- 2. ดึงค่าดาเมจหลักของผู้เล่น
-- ==========================================
local function getPlayerBaseDamage()
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local statDamage = leaderstats:FindFirstChild("Damage") or leaderstats:FindFirstChild("Strength") or leaderstats:FindFirstChild("Dmg")
		if statDamage and tonumber(statDamage.Value) then
			return tonumber(statDamage.Value)
		end
	end
	return 0
end

-- ==========================================
-- 3. ตรวจสอบอาวุธและประเภท
-- ==========================================
local function getWeaponInfo(character)
	local tool = character:FindFirstChildOfClass("Tool")
	if not tool then
		return "มือเปล่า (Unarmed)", "Melee", 0.5, 12, Color3.fromRGB(200, 200, 200)
	end

	local name = tool.Name:lower()

	if name:find("gun") or name:find("pistol") or name:find("rifle") or name:find("shotgun") or name:find("sniper") or name:find("ปืน") then
		return tool.Name, "Ranged (ปืนระยะไกล)", 2.0, 50, Color3.fromRGB(100, 220, 255)
	elseif name:find("knife") or name:find("sword") or name:find("blade") or name:find("axe") or name:find("มีด") or name:find("ดาบ") then
		return tool.Name, "Melee (ระยะประชิด)", 1.2, 15, Color3.fromRGB(255, 220, 100)
	else
		return tool.Name, "Melee (ทั่วไป)", 1.0, 15, Color3.fromRGB(255, 150, 100)
	end
end

