		toggleBtn.BackgroundColor3 = Color3.fromRGB(240, 130, 30)
	else
		currentTargetMode = "NPC"
		toggleBtn.Text = "MODE: TARGET NPC"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(45, 140, 240)
	end
end)

dealDamageBtn.MouseButton1Click:Connect(function()
	local baseDamage = DamageConfig.Parse(inputTextBox.Text)
	local character = player.Character
	if not character then return end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	-- เช็คว่าถืออาวุธไหม และรับตัวคูณดาเมจ
	local isHolding, weaponName, multiplier = getEquippedWeaponInfo(character)
	local finalDamage = baseDamage * multiplier -- ดาเมจสุทธิคูณตามอาวุธที่ถือ

	local hitCount = 0

	for _, object in ipairs(workspace:GetChildren()) do
		local humanoid = object:FindFirstChildOfClass("Humanoid")
		local targetRoot = object:FindFirstChild("HumanoidRootPart") or object:FindFirstChild("PrimaryPart")

		if humanoid and targetRoot and humanoid.Health > 0 and object ~= character then
			local distance = (targetRoot.Position - rootPart.Position).Magnitude
			if distance <= 25 then
				local isPlayer = Players:GetPlayerFromCharacter(object) ~= nil

				if currentTargetMode == "NPC" and not isPlayer then
					humanoid:TakeDamage(finalDamage)
					hitCount += 1
				elseif currentTargetMode == "Player" and isPlayer then
					humanoid:TakeDamage(finalDamage)
					hitCount += 1
				end
			end
		end
	end

	print(string.format("🔥 [Mode: %s] อุปกรณ์: %s | โจมตีโดน %d เป้าหมาย | ดาเมจรุนแรง: %.2e", 
		currentTargetMode, weaponName, hitCount, finalDamage))
end)

