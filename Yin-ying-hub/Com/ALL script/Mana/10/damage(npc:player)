	player.Character.ChildAdded:Connect(function(c) if c:IsA("Tool") then task.wait(0.1) updateUIStatus() end end)
	player.Character.ChildRemoved:Connect(function(c) if c:IsA("Tool") then task.wait(0.1) updateUIStatus() end end)
end

