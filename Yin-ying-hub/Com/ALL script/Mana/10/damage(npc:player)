-- ==========================================
-- 1. ฟังก์ชันแปลงตัวเลขสเกลสูง (Nonillion / No)
-- ==========================================
local DamageConfig = {}
DamageConfig.Suffixes = {
	{ Threshold = 1e30, Suffix = "No" },
	{ Threshold = 1e27, Suffix = "Oc" },
	{ Threshold = 1e24, Suffix = "Sp" },
	{ Threshold = 1e21, Suffix = "Sx" },
	{ Threshold = 1e18, Suffix = "Qi" },
	{ Threshold = 1e15, Suffix = "Qa" },
	{ Threshold = 1e12, Suffix = "T"  },
	{ Threshold = 1e9,  Suffix = "B"  },
	{ Threshold = 1e6,  Suffix = "M"  },
	{ Threshold = 1e3,  Suffix = "K"  },
}

function DamageConfig.Parse(inputText)
	if type(inputText) ~= "string" then return 0 end
	local text = string.upper(inputText):gsub("%s+", "")
	if text == "" or #text > 30 then return 0 end

	for _, data in ipairs(DamageConfig.Suffixes) do
		local suffix = string.upper(data.Suffix)
		if text:find(suffix .. "$") then
			local numberPart = text:gsub(suffix .. "$", "")
			local val = tonumber(numberPart)
			if val then
				return val * data.Threshold
			end
		end
	end
	return tonumber(text) or 0
end

-- ==========================================
-- 2. ดึงค่าดาเมจหลักของผู้เล่น (จาก Stat ในเกม หรือค่าที่ตั้งไว้)
-- ==========================================
local function getPlayerBaseDamage()
	-- ตรวจสอบว่าในตัวผู้เล่นมีค่า Stat ดาเมจสะสมอยู่ไหม (เช่น leaderstats -> Damage หรือ Strength)
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		local statDamage = leaderstats:FindFirstChild("Damage") or leaderstats:FindFirstChild("Strength") or leaderstats:FindFirstChild("Dmg")
		if statDamage and tonumber(statDamage.Value) then
			return tonumber(statDamage.Value)
		end
	end
	
	-- ถ้าไม่มีค่า Stat ใน leaderstats ให้คืนค่าเริ่มต้นเป็น 0 (เพื่อให้ใช้ค่าที่พิมพ์ในช่อง UI แทน)
	return 0
end

-- ==========================================
-- 3. ตรวจสอบอาวุธ / มือเปล่า และกำหนดตัวคูณ
-- ==========================================
local function getWeaponInfo(character)
	local tool = character:FindFirstChildOfClass("Tool")
	if not tool then
		-- กรณี: มือเปล่า (ไม่มีอาวุธ)
		return "มือเปล่า (Unarmed)", "Melee", 0.5, 12 -- ชื่อ, ประเภท, ตัวคูณ, ระยะโจมตี
	end

	local name = tool.Name:lower()

	-- อาวุธระยะไกล (ปืนต่างๆ)
	if name:find("gun") or name:find("pistol") or name:find("rifle") or name:find("shotgun") or name:find("sniper") or name:find("ปืน") then
		return tool.Name, "Ranged (ปืนระยะไกล)", 2.0, 50
	
	-- อาวุธระยะประชิด (ดาบ, มีด)
	elseif name:find("knife") or name:find("sword") or name:find("blade") or name:find("axe") or name:find("มีด") or name:find("ดาบ") then
		return tool.Name, "Melee (ระยะประชิด)", 1.2, 15
	
	else
		return tool.Name, "Melee (ทั่วไป)", 1.0, 15
	end
end

