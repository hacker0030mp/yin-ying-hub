-- 5. อัปเดตข้อมูล UI แบบเรียลไทม์
-- ==========================================
local function updateUIStatus()
	local char = player.Character
	if char then
		local wName, wType, mult, range = getWeaponInfo(char)
		local baseDmg = getPlayerBaseDamage()
		
		if baseDmg > 0 then
			statusLabel.Text = string.format("📊 ดาเมจตัวละคร: %.1e | อุปกรณ์: %s", baseDmg, wName)
		else
			statusLabel.Text = string.format("🛡️ อุปกรณ์: %s (ตัวคูณ x%.1f)", wName, mult)
		end
		
		if wType:find("Ranged") then
			statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
		elseif wType:find("Melee") and wName ~= "มือเปล่า (Unarmed)" then
			statusLabel.TextColor3 = Color3.fromRGB(255, 220, 100)
		else
			statusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
		end
	end
end

