-- 1. ฟังก์ชันแปลงตัวเลขสเกลสูง (Nonillion / No)
-- ==========================================
local DamageConfig = {}
DamageConfig.Suffixes = {
	{ Threshold = 1e30, Suffix = "No" },
	{ Threshold = 1e27, Suffix = "Oc" },
	{ Threshold = 1e24, Suffix = "Sp" },
	{ Threshold = 1e21, Suffix = "Sx" },
	{ Threshold = 1e18, Suffix = "Qi" },
	{ Threshold = 1e15, Suffix = "Qa" },
	{ Threshold = 1e12, Suffix = "T"  },
	{ Threshold = 1e9,  Suffix = "B"  },
	{ Threshold = 1e6,  Suffix = "M"  },
	{ Threshold = 1e3,  Suffix = "K"  },
}

function DamageConfig.Parse(inputText)
	if type(inputText) ~= "string" then return 0 end
	local text = string.upper(inputText):gsub("%s+", "")
	if text == "" or #text > 30 then return 0 end

	for _, data in ipairs(DamageConfig.Suffixes) do
		local suffix = string.upper(data.Suffix)
		if text:find(suffix .. "$") then
			local numberPart = text:gsub(suffix .. "$", "")
			local val = tonumber(numberPart)
			if val then
				return val * data.Threshold
			end
		end
	end
	return tonumber(text) or 0
end

function DamageConfig.Format(number)
	if number >= 1e30 then return string.format("%.2fNo", number / 1e30) end
	if number >= 1e27 then return string.format("%.2fOc", number / 1e27) end
	if number >= 1e24 then return string.format("%.2fSp", number / 1e24) end
	if number >= 1e21 then return string.format("%.2fSx", number / 1e21) end
	if number >= 1e18 then return string.format("%.2fQi", number / 1e18) end
	if number >= 1e15 then return string.format("%.2fQa", number / 1e15) end
	if number >= 1e12 then return string.format("%.2fT", number / 1e12) end
	if number >= 1e9  then return string.format("%.2fB", number / 1e9) end
	if number >= 1e6  then return string.format("%.2fM", number / 1e6) end
	if number >= 1e3  then return string.format("%.2fK", number / 1e3) end
	return tostring(math.floor(number))
end

