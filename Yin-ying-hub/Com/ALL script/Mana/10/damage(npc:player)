		currentTargetMode = "Player"
		toggleBtn.Text = "MODE: TARGET PLAYER"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(240, 130, 30)
	else
		currentTargetMode = "NPC"
		toggleBtn.Text = "MODE: TARGET NPC"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(45, 140, 240)
	end
end)

dealDamageBtn.MouseButton1Click:Connect(function()
	local inputDamage = DamageConfig.Parse(inputTextBox.Text)
	local baseStatDamage = getPlayerBaseDamage()
	
	-- หากมีค่า Stat ดาเมจในตัวผู้เล่น ให้เอามาบวก/รวมกัน หรือใช้ค่าที่พิมพ์ หากไม่มี Stat
	local coreDamage = (baseStatDamage > 0) and baseStatDamage or inputDamage
	
	local char = player.Character
	if not char then return end
	local rootPart = char:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	-- ดึงข้อมูลอาวุธและตัวคูณ
	local wName, wType, multiplier, maxRange = getWeaponInfo(char)
	local finalDamage = coreDamage * multiplier -- ดาเมจสุทธิ (ดาเมจตัวละคร/ที่พิมพ์ x ตัวคูณอาวุธหรือมือเปล่า)

	local hitCount = 0

	for _, object in ipairs(workspace:GetChildren()) do
		local humanoid = object:FindFirstChildOfClass("Humanoid")
		local targetRoot = object:FindFirstChild("HumanoidRootPart") or object:FindFirstChild("PrimaryPart")

		if humanoid and targetRoot and humanoid.Health > 0 and object ~= char then
			local distance = (targetRoot.Position - rootPart.Position).Magnitude
			if distance <= maxRange then
				local isPlayer = Players:GetPlayerFromCharacter(object) ~= nil

				if currentTargetMode == "NPC" and not isPlayer then
					humanoid:TakeDamage(finalDamage)
					hitCount += 1
				elseif currentTargetMode == "Player" and isPlayer then
					humanoid:TakeDamage(finalDamage)
					hitCount += 1
				end
			end
		end
	end

	print(string.format("🎯 [Mode: %s] | อาวุธ: %s | โดน %d เป้าหมาย | ดาเมจสุทธิ: %.2e", 
		currentTargetMode, wName, hitCount, finalDamage))
end)

print("✅ โหลดระบบดาเมจตัวละคร + อาวุธสำเร็จ!")
