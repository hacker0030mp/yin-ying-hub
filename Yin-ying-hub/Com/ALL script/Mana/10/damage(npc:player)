-- 6. ระบบตรวจสอบสถานะและคุณภาพ (Quality & Performance Monitor)
-- ==========================================
local lastTick = tick()
local frameCount = 0
local currentFPS = 60

RunService.RenderStepped:Connect(function(dt)
	frameCount += 1
	if tick() - lastTick >= 1 then
		currentFPS = math.floor(frameCount / (tick() - lastTick) + 0.5)
		frameCount = 0
		lastTick = tick()

		pcall(function()
			local ping = math.floor(player:GetNetworkPing() * 1000 + 0.5)
			qualityLabel.Text = string.format("🟢 FPS: %d | Ping: %ms | คุณภาพ: สมบูรณ์", currentFPS, ping)
		end)
	end
end)

