	end
end)

dealDamageBtn.MouseButton1Click:Connect(function()
	local inputDamage = DamageConfig.Parse(inputTextBox.Text)
	local baseStatDamage = getPlayerBaseDamage()
	local coreDamage = (baseStatDamage > 0) and baseStatDamage or inputDamage
	
	local char = player.Character
	if not char then return end
	local rootPart = char:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	local wName, wType, multiplier, maxRange, wColor = getWeaponInfo(char)
	local finalDamage = coreDamage * multiplier
	local hitCount = 0

	-- ระบบตรวจจับเป้าหมายทั่ว Workspace อย่างแม่นยำ
	for _, object in ipairs(workspace:GetDescendants()) do
		if object:IsA("Humanoid") and object.Health > 0 then
			local model = object.Parent
			if model and model ~= char and model:IsA("Model") then
				local targetRoot = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("PrimaryPart")
				if targetRoot then
					local distance = (targetRoot.Position - rootPart.Position).Magnitude
					if distance <= maxRange then
						local isPlayer = Players:GetPlayerFromCharacter(model) ~= nil

						if currentTargetMode == "NPC" and not isPlayer then
							object:TakeDamage(finalDamage)
							showFloatingDamage(targetRoot, finalDamage, wColor)
							hitCount += 1
						elseif currentTargetMode == "Player" and isPlayer then
							object:TakeDamage(finalDamage)
							showFloatingDamage(targetRoot, finalDamage, wColor)
							hitCount += 1
						end
					end
				end
			end
		end
	end

	print(string.format("🎯 [Mode: %s] | อาวุธ: %s | โดน %d เป้าหมาย | ดาเมจสุทธิ: %s", 
		currentTargetMode, wName, hitCount, DamageConfig.Format(finalDamage)))
end)

