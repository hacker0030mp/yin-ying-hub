local function updateUIStatus()
	local char = player.Character
	if char then
		local wName, wType, mult, range, color = getWeaponInfo(char)
		local baseDmg = getPlayerBaseDamage()
		
		if baseDmg > 0 then
			statusLabel.Text = string.format("📊 ดาเมจตัวละคร: %.1e | อุปกรณ์: %s", baseDmg, wName)
		else
			statusLabel.Text = string.format("🛡️ อุปกรณ์: %s (ตัวคูณ x%.1f)", wName, mult)
		end
		statusLabel.TextColor3 = color
	end
end

player.CharacterAdded:Connect(function(char)
	char.ChildAdded:Connect(function(c) if c:IsA("Tool") then task.wait(0.1) updateUIStatus() end end)
	char.ChildRemoved:Connect(function(c) if c:IsA("Tool") then task.wait(0.1) updateUIStatus() end end)
end)

if player.Character then
	updateUIStatus()
	player.Character.ChildAdded:Connect(function(c) if c:IsA("Tool") then task.wait(0.1) updateUIStatus() end end)
	player.Character.ChildRemoved:Connect(function(c) if c:IsA("Tool") then task.wait(0.1) updateUIStatus() end end)
end

