local function updateWeaponUI()
	local character = player.Character
	if character then
		local isHolding, weaponName, multiplier = getEquippedWeaponInfo(character)
		if isHolding then
			statusLabel.Text = "⚔️ ถือ: " .. weaponName .. " (x" .. multiplier .. ")"
			statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
		else
			statusLabel.Text = "✊ มือเปล่า (ดาเมจปกติ/ลดลง)"
			statusLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
		end
	end
end

-- อัปเดตทุกครั้งที่เปลี่ยนอุปกรณ์ในมือ
