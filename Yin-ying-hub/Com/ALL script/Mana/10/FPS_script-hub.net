        WindowTitle = "FPS Ultimate Combat Hub v",
        WindowSubTitle = "Advanced Shooting & Performance Suite",
        MainTab = "Main",
        AimbotTab = "Aimbot",
        VisualsTab = "Visuals",
        WeaponTab = "Weapon",
