        WindowTitle = "ระบบสคริปต์ FPS ขั้นสูง v",
        WindowSubTitle = "ชุดคำสั่งเกมยิงปืนและตรวจสอบระบบ",
        MainTab = "หน้าหลัก",
        AimbotTab = "ล็อกเป้า",
        VisualsTab = "การมองเห็น",
        WeaponTab = "ปรับปืน",
