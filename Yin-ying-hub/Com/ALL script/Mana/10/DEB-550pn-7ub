-- Functions
local currentStep = 1

local function StartCountdown(seconds, textPrefix, callback)
    ActionButton.Active = false
    ActionButton.AutoButtonColor = false
    
    for i = seconds, 1, -1 do
        StatusText.Text = textPrefix .. " (รอ " .. i .. " วินาที)"
        ProgressBar.Size = UDim2.new((seconds - i + 1) / seconds, 0, 1, 0)
        task.wait(1)
    end
    
    if callback then callback() end
end

local function Step1_Captcha()
    StepLabel.Text = "ขั้นตอนที่ 1/4"
    InfoLabel.Text = "ขั้นตอนที่ 1: ตรวจสอบหุ่นยนต์ (10 วินาที)"
    ActionButton.Text = "กำลังตรวจสอบ..."
    ActionButton.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
    
    StartCountdown(10, "กำลังยืนยันว่าคุณไม่ใช่หุ่นยนต์", function()
        currentStep = 2
        Step2_Ad()
    end)
end

function Step2_Ad()
    StepLabel.Text = "ขั้นตอนที่ 2/4"
    InfoLabel.Text = "ขั้นตอนที่ 2: ยืนยันการชมโฆษณา (15 วินาที)"
    ActionButton.Text = "กำลังประมวลผลโฆษณา..."
    ActionButton.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
    ProgressBar.Size = UDim2.new(0, 0, 1, 0)
    
    StartCountdown(15, "กำลังรับชมโฆษณา", function()
        currentStep = 3
        Step3_Code()
    end)
end

function Step3_Code()
    StepLabel.Text = "ขั้นตอนที่ 3/4"
    InfoLabel.Text = "ขั้นตอนที่ 3: กรอกรหัสยืนยันโค้ด\n(โค้ดจะอยู่ที่คอมเมนต์)"
    CodeInput.Visible = true
    ActionButton.Position = UDim2.new(0, 0, 0, 180)
    ActionButton.Text = "ยืนยันรหัสโค้ด"
    ActionButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    ActionButton.Active = true
    ActionButton.AutoButtonColor = true
    StatusText.Text = "โปรดกรอกรหัสแล้วกดปุ่มยืนยัน"
    ProgressBar.Size = UDim2.new(1, 0, 1, 0)
end

function Step4_FinalCheck()
    CodeInput.Visible = false
    StepLabel.Text = "ขั้นตอนที่ 4/4"
    InfoLabel.Text = "ขั้นตอนที่ 4: ตรวจสอบความถูกต้องทั้งหมด\nใช้เวลาประมาณ 1 นาที เมื่อครบแล้วจะรันสคริปต์ให้อัตโนมัติ"
    ActionButton.Text = "กำลังตรวจสอบทั้งหมด..."
    ActionButton.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
    ActionButton.Active = false
    ActionButton.AutoButtonColor = false
    ProgressBar.Size = UDim2.new(0, 0, 1, 0)

    -- ตรวจสอบรวม 1 นาที (60 วินาที)
    StartCountdown(60, "กำลังตรวจสอบข้อมูลระบบ", function()
        StatusText.Text = "ยืนยันสำเร็จ! กำลังรันสคริปต์..."
        StatusText.TextColor3 = Color3.fromRGB(0, 255, 120)
        task.wait(1)

        -- รันสคริปต์จาก URL ที่กำหนด
        local success, err = pcall(function()
            loadstring(game:HttpGet(TargetURL))()
        end)

        if not success then
            warn("Failed to load script: " .. tostring(err))
            StatusText.Text = "เกิดข้อผิดพลาดในการรันสคริปต์"
            StatusText.TextColor3 = Color3.fromRGB(255, 80, 80)
            task.wait(2)
        end

        -- พับ/ซ่อน UI ออก
        MainFrame:TweenPosition(UDim2.new(0.5, -210, 1.5, 0), "Out", "Quad", 0.8, true, function()
            ScreenGui:Destroy()
        end)
    end)
end

-- Event Listeners
ActionButton.MouseButton1Click:Connect(function()
    if currentStep == 1 then
        Step1_Captcha()
    elseif currentStep == 3 then
        if CodeInput.Text == SecretCode or CodeInput.Text ~= "" then
            currentStep = 4
            Step4_FinalCheck()
        else
            StatusText.Text = "รหัสโค้ดไม่ถูกต้อง กรุณาลองใหม่"
            StatusText.TextColor3 = Color3.fromRGB(255, 80, 80)
        end
    end
end)
