-- 🛡️ YIN YANG SAFE LINK LOADER
-- ตรวจสอบ URL / ดักข้อผิดพลาด / ป้องกันการโหลดซ้ำ
-- ไม่ execute โค้ดจาก URL

local TARGET_SCRIPT_URL =
    "https://raw.githubusercontent.com/hacker0030mp/yin-ying-hub/refs/heads/main/Yin-ying-hub/Com/ALL%20script/Mana/Zip.mm"

local HttpService = game:GetService("HttpService")

local isLoading = false
local hasLoaded = false

local function loadAndCheck()
    if isLoading then
        return false, "กำลังโหลดอยู่ กรุณารอสักครู่"
    end

    if hasLoaded then
        return false, "ลิงก์นี้ถูกตรวจสอบแล้ว"
    end

    isLoading = true

    local ok, result = pcall(function()
        return game:HttpGet(TARGET_SCRIPT_URL)
    end)

    isLoading = false

    if not ok then
        warn("[YIN YANG] ดาวน์โหลดไม่สำเร็จ:", result)
        return false, "ดาวน์โหลดไม่สำเร็จ กรุณาตรวจสอบ URL หรือเครือข่าย"
    end

    if type(result) ~= "string" or result == "" then
        return false, "เซิร์ฟเวอร์ส่งข้อมูลว่างกลับมา"
    end

    -- ตรวจว่าลิงก์อาจส่งหน้าเว็บ Error กลับมาแทนโค้ด
    local body = result:lower()

    if body:find("<!doctype html", 1, true)
        or body:find("<html", 1, true) then
        return false, "ได้รับ HTML แทนไฟล์ที่คาดหวัง"
    end

    hasLoaded = true

    print("[YIN YANG] ดาวน์โหลดสำเร็จ")
    print("[YIN YANG] ขนาดข้อมูล:", #result, "bytes")

    -- ยังไม่ execute เนื้อหาที่ดาวน์โหลด
    return true, result
end

local success, dataOrError = loadAndCheck()

if success then
    print("[YIN YANG] ตรวจสอบเบื้องต้นผ่าน")
else
    warn("[YIN YANG] " .. tostring(dataOrError))
end
