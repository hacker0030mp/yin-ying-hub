    button.AutoButtonColor = true
    button.Parent = content
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)
    local enabled = initial or false
    button.MouseButton1Click:Connect(function()
        enabled = not enabled
        button.BackgroundColor3 = enabled and Color3.fromRGB(20, 105, 75) or Color3.fromRGB(28, 53, 47)
        button.Text = labelText .. (enabled and "  [เปิด]" or "  [ปิด]")
        callback(enabled)
    end)
    return button
end

local function addSlider(labelText, minValue, maxValue, defaultValue, callback)
    local wrap = Instance.new("Frame")
    wrap.Size = UDim2.new(1, -4, 0, 56)
    wrap.BackgroundColor3 = Color3.fromRGB(22, 43, 38)
    wrap.Parent = content
    Instance.new("UICorner", wrap).CornerRadius = UDim.new(0, 8)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 0, 24)
    label.Position = UDim2.fromOffset(10, 2)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(235, 255, 246)
    label.Font = Enum.Font.Gotham
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = labelText .. ": " .. tostring(defaultValue)
    label.Parent = wrap

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -20, 0, 8)
    bar.Position = UDim2.fromOffset(10, 35)
    bar.BackgroundColor3 = Color3.fromRGB(45, 75, 65)
    bar.Parent = wrap
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((defaultValue - minValue) / (maxValue - minValue), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(35, 220, 145)
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("TextButton")
    knob.Size = UDim2.fromOffset(18, 18)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(fill.Size.X.Scale, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.fromRGB(220, 255, 235)
    knob.Text = ""
    knob.Parent = bar
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local dragging = false
    local function update(inputX)
        local width = math.max(1, bar.AbsoluteSize.X)
        local alpha = math.clamp((inputX - bar.AbsolutePosition.X) / width, 0, 1)
        local value = math.floor(minValue + (maxValue - minValue) * alpha)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        label.Text = labelText .. ": " .. tostring(value)
        callback(value)
    end
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

-- ===== FEATURES =====
local function setFast(enabled)
    state.fast = enabled
    local _, hum = getCharacter()
    if hum then
        if enabled then
            originalWalkSpeed = originalWalkSpeed or hum.WalkSpeed
            hum.WalkSpeed = CONFIG.WalkSpeed
        else
            hum.WalkSpeed = originalWalkSpeed or 16
            originalWalkSpeed = nil
        end
    end
end

local function setHighJump(enabled)
    state.highJump = enabled
    local _, hum = getCharacter()
    if hum then
        if enabled then
            originalJumpPower = originalJumpPower or hum.JumpPower
            hum.UseJumpPower = true
            hum.JumpPower = CONFIG.JumpPower
        else
            hum.JumpPower = originalJumpPower or 50
            originalJumpPower = nil
        end
    end
end

local function setFly(enabled)
    state.flying = enabled
    local _, hum, hrp = getCharacter()
    if not hrp or not hum then return end
    if enabled then
        flyVelocity = Instance.new("BodyVelocity")
        flyVelocity.Name = "HubFlyVelocity"
        flyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        flyVelocity.Velocity = Vector3.zero
        flyVelocity.Parent = hrp

        flyGyro = Instance.new("BodyGyro")
        flyGyro.Name = "HubFlyGyro"
        flyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        flyGyro.P = 9000
        flyGyro.CFrame = hrp.CFrame
        flyGyro.Parent = hrp
        hum.PlatformStand = true
    else
        if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
        if flyGyro then flyGyro:Destroy(); flyGyro = nil end
        hum.PlatformStand = false
    end
end

local function setNoclip(enabled)
    state.noclip = enabled
end

local function setFullbright(enabled)
    state.fullbright = enabled
    if enabled then
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(180, 180, 180)
    else
        Lighting.Brightness = 1
        Lighting.GlobalShadows = true
    end
end

local function setPlatform(enabled)
    state.platform = enabled
    if enabled then
        local _, _, hrp = getCharacter()
        if not hrp then return end
        platformPart = Instance.new("Part")
        platformPart.Name = "LocalHubPlatform"
        platformPart.Size = Vector3.new(16, 1, 16)
