end

local function clearMarkers()
    if markerFolder then markerFolder:Destroy(); markerFolder = nil end
end

local function setMarkers(enabled)
    state.markers = enabled
    clearMarkers()
    if not enabled then return end
    markerFolder = Instance.new("Folder")
    markerFolder.Name = "LocalCollectibleMarkers"
    markerFolder.Parent = workspace
    
    for _, item in ipairs(workspace:GetDescendants()) do
        if item:IsA("BasePart") and (item.Name:lower():find("token") or item.Name:lower():find("collect") or item.Name:lower():find("item")) then
            local bill = Instance.new("BillboardGui")
            bill.Name = "CollectibleMarker"
            bill.Size = UDim2.fromOffset(150, 30)
            bill.StudsOffset = Vector3.new(0, 2.5, 0)
            bill.AlwaysOnTop = true
            bill.Adornee = item
            bill.Parent = markerFolder
            
            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.fromScale(1, 1)
            txt.BackgroundTransparency = 1
            txt.Text = "✦ " .. item.Name
            txt.TextColor3 = Color3.fromRGB(100, 255, 185)
            txt.TextStrokeTransparency = 0.35
            txt.Font = Enum.Font.GothamBold
            txt.TextSize = 13
            txt.Parent = bill
        end
    end
end

