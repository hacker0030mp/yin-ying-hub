local eventManagerModule = ServerScriptService:FindFirstChild("EventManager") or Instance.new("ModuleScript")
eventManagerModule.Name = "EventManager"
eventManagerModule.Parent = ServerScriptService

eventManagerModule.Source = [[
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local EventConfig = require(ReplicatedStorage:WaitForChild("EventConfig"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Notification = Remotes:WaitForChild("EventNotification")

local EventManager = {}
local activeEvent = nil
local lastStarted = {}
local eventToken = 0
local activeInstances = {}

local function clearEventObjects()
    for _, obj in ipairs(activeInstances) do
        if obj and obj.Parent then
            obj:Destroy()
        end
    end
    activeInstances = {}
end

local function runEventGameplay(eventId, token)
    if eventId == "EmeraldStorm" or eventId == "GoldRush" then
        task.spawn(function()
            local isGold = (eventId == "GoldRush")
            while activeEvent and activeEvent.Token == token do
                local gem = Instance.new("Part")
                gem.Name = isGold and "GoldCoin" or "EmeraldGem"
                gem.Shape = Enum.PartType.Ball
                gem.Size = Vector3.new(2.2, 2.2, 2.2)
                gem.Material = Enum.Material.Neon
                gem.Color = isGold and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(38, 220, 151)
                gem.Position = Vector3.new(math.random(-50, 50), 35, math.random(-50, 50))
                gem.Anchored = false
                gem.CanCollide = true
                gem.Parent = Workspace
                
                table.insert(activeInstances, gem)

                local touched = false
                gem.Touched:Connect(function(hit)
                    if touched then return end
                    local player = Players:GetPlayerFromCharacter(hit.Parent)
                    if player and player:FindFirstChild("leaderstats") then
                        touched = true
                        local mult = (player.leaderstats.Rebirths.Value + 1)
                        local addAmount = (isGold and 25 or 15) * mult
                        player.leaderstats.Gold.Value += addAmount
                        player.leaderstats.EXP.Value += 10
                        gem:Destroy()
                    end
                end)
                task.wait(isGold and 0.8 or 1.2)
            end
        end)

    elseif eventId == "YinYangAwakening" then
        local zone = Instance.new("Part")
        zone.Name = "YinYangZone"
        zone.Shape = Enum.PartType.Cylinder
        zone.Size = Vector3.new(1, 28, 28)
        zone.Orientation = Vector3.new(0, 0, 90)
        zone.Position = Vector3.new(0, 2, 0)
        zone.Material = Enum.Material.Neon
        zone.Color = Color3.fromRGB(160, 255, 216)
        zone.Transparency = 0.4
        zone.Anchored = true
        zone.CanCollide = false
        zone.Parent = Workspace
        table.insert(activeInstances, zone)

        task.spawn(function()
            while activeEvent and activeEvent.Token == token do
                for _, player in ipairs(Players:GetPlayers()) do
                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local pos = player.Character.HumanoidRootPart.Position
                        if (pos - zone.Position).Magnitude <= 14 then
                            if player:FindFirstChild("leaderstats") then
                                player.leaderstats["YinYang Power"].Value += 5
                                player.leaderstats.EXP.Value += 5
                            end
                        end
                    end
                end
                task.wait(1)
            end
        end)

    elseif eventId == "BossInvasion" then
        local boss = Instance.new("Part")
        boss.Name = "YinYangBoss"
        boss.Size = Vector3.new(8, 12, 8)
        boss.Position = Vector3.new(0, 6, 0)
        boss.Material = Enum.Material.ForceField
        boss.Color = Color3.fromRGB(20, 20, 20)
        boss.Anchored = true
        boss.Parent = Workspace
        table.insert(activeInstances, boss)

        local clickDetector = Instance.new("ClickDetector")
        clickDetector.MaxActivationDistance = 32
        clickDetector.Parent = boss

        clickDetector.MouseClick:Connect(function(player)
            if player and player:FindFirstChild("leaderstats") then
                player.leaderstats.Gold.Value += 30
                player.leaderstats.EXP.Value += 20
            end
        end)
    end
end

function EventManager.GetActiveEvent() return activeEvent end

function EventManager.Start(eventId)
    local config = EventConfig.Events[eventId]
    if not config or activeEvent then return false, "Cannot start event" end

    local now = os.clock()
    eventToken += 1
    local myToken = eventToken
    lastStarted[eventId] = now

    activeEvent = {
        Id = eventId,
        Name = config.Name,
        StartedAt = now,
        Duration = config.Duration,
        Token = myToken,
    }

    Notification:FireAllClients("Started", {
        Id = eventId,
        Name = config.Name,
        Description = config.Description,
        Duration = config.Duration,
    })

    print("[YIN YANG EVENT] Started:", config.Name)
    runEventGameplay(eventId, myToken)

    task.delay(config.Duration, function()
        if activeEvent and activeEvent.Token == myToken then
            EventManager.Stop(eventId)
        end
    end)
    return true, "Success"
end

function EventManager.Stop(eventId)
    if not activeEvent then return false, "No active event" end
    local finished = activeEvent
    activeEvent = nil
    clearEventObjects()

    local config = EventConfig.Events[finished.Id]
    if config and config.Reward then
        for _, player in ipairs(Players:GetPlayers()) do
            if player:FindFirstChild("leaderstats") then
                player.leaderstats.Gold.Value += config.Reward
                player.leaderstats.EXP.Value += 50
                -- Check Level Up
                if player.leaderstats.EXP.Value >= player.leaderstats.Level.Value * 100 then
                    player.leaderstats.Level.Value += 1
                    player.leaderstats.Gems.Value += 5
                end
            end
        end
    end

    Notification:FireAllClients("Ended", {Id = finished.Id, Name = finished.Name})
    print("[YIN YANG EVENT] Ended:", finished.Name)
    return true, "Success"
end

return EventManager
]]

