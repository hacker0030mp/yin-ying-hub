local actionHandler = ServerScriptService:FindFirstChild("YinYangActionHandler") or Instance.new("Script")
actionHandler.Name = "YinYangActionHandler"
actionHandler.Parent = ServerScriptService

actionHandler.Source = [[
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local actionRemote = Remotes:WaitForChild("YinYangAction")

local redeemedCodes = {}

actionRemote.OnServerInvoke = function(player, actionType, payload)
    if not player or not player:FindFirstChild("leaderstats") then return false, "No Data" end
    local stats = player.leaderstats

    if actionType == "BuySpeed" then
        if stats.Gold.Value >= 100 then
            stats.Gold.Value -= 100
            if player.Character and player.Character:FindFirstChild("Humanoid") then
                player.Character.Humanoid.WalkSpeed = 26
            end
            return true, "ซื้อ Speed Boost สำเร็จ! (วิ่งไวขึ้น)"
        end
        return false, "Gold ไม่พอ! (ต้องการ 100 Gold)"

    elseif actionType == "BuyJump" then
        if stats.Gold.Value >= 100 then
            stats.Gold.Value -= 100
            if player.Character and player.Character:FindFirstChild("Humanoid") then
                player.Character.Humanoid.JumpPower = 80
            end
            return true, "ซื้อ Jump Boost สำเร็จ! (กระโดดสูงขึ้น)"
        end
        return false, "Gold ไม่พอ! (ต้องการ 100 Gold)"

    elseif actionType == "ClaimDaily" then
        stats.Gold.Value += 250
        stats.Gems.Value += 5
        return true, "ได้รับ Daily Bonus: +250 Gold, +5 Gems!"

    elseif actionType == "RedeemCode" then
        local code = tostring(payload):upper()
        redeemedCodes[player.UserId] = redeemedCodes[player.UserId] or {}
        if redeemedCodes[player.UserId][code] then
            return false, "คุณใช้โค้ดนี้ไปแล้ว!"
        end

        if code == "YINYANG2026" or code == "FREEGOLD" then
            redeemedCodes[player.UserId][code] = true
            stats.Gold.Value += 500
            stats.Gems.Value += 10
            return true, "แลกโค้ดสำเร็จ! ได้รับ +500 Gold, +10 Gems!"
        end
        return false, "โค้ดไม่ถูกต้อง!"

    elseif actionType == "Rebirth" then
        if stats.Gold.Value >= 2000 then
            stats.Gold.Value = 0
            stats.Rebirths.Value += 1
            return true, "Rebirth สำเร็จ! รับตัวคูณรายได้เพิ่มขึ้น!"
        end
        return false, "ต้องการ 2,000 Gold ในการ Rebirth!"
    end

    return false, "Invalid Action"
end
]]

